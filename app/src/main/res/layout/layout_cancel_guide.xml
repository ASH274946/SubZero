<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp">

    <!-- Solid White Tactile M3 Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_m3_dialog_surface"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title & App Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGuideTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancel Subscription"
                android:textColor="#19231E"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGuideAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_m3_chip_active"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="PhonePe"
                android:textColor="#1E5144"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- UMN Monospace Notice -->
        <TextView
            android:id="@+id/tvGuideUmn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="UMN: Copied to clipboard"
            android:textColor="#5A6F66"
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#EAF2ED" />

        <!-- 3-Step Checklist -->
        <TextView
            android:id="@+id/tvGuideSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="1. Tap your Profile icon at the top left.\n2. Open 'AutoPay Settings'.\n3. Locate this mandate and tap 'Pause/Revoke'."
            android:textColor="#19231E"
            android:textSize="13sp" />

        <!-- PRIMARY DYNAMIC BUTTON: "Open [AppName] & Cancel Subscription" -->
        <Button
            android:id="@+id/btnOpenAppAndCancel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_m3_pill_button"
            android:text="Open PhonePe &amp; Cancel Subscription"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- SECONDARY BUTTON: "Done" -->
        <Button
            android:id="@+id/btnGuideDone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_m3_light_button"
            android:text="Done"
            android:textColor="#19231E"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
