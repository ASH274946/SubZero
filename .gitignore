# ====================================================================
# SubZero: Android & Gradle Root .gitignore
# ====================================================================

# Built application files & directories
*.apk
*.aab
*.ap_
*.dex

# Gradle build cache & intermediate outputs
.gradle/
build/
*/build/
bin/
gen/
out/
.navigation/

# Local configuration & environment secrets (Never commit)
local.properties
.attach_pid*
gradle.properties.local

# Android Studio / IntelliJ IDEA files
.idea/
*.iml
*.iws
*.ipr
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/tasks.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/deploymentTargetSelector.xml
.idea/kotlinc.xml

# CMake & Native C/C++ compilation caches
.cxx/
*.cxx
default/
compile_commands.json

# Signing configurations & Keystores
*.jks
*.keystore
*.p12
*.key
signing.properties

# Large On-Device Machine Learning Models & Quantized Weights
# (Pushed directly to /data/local/tmp/ via ADB to keep repository lean)
*.bin
*.task
*.tflite
*.onnx
models/
assets/models/*.bin
assets/models/*.task

# OS & Environment Metadata
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*.swp
*~
*.bak

# Profiler, coverage & log reports
captures/
*.hprof
.externalNativeBuild/
recordings/
lint/reports/
lint/intermediates/

# Node / Web dependencies & build artifacts
node_modules/
*/node_modules/
dist/
*/dist/
.vite/
*/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

